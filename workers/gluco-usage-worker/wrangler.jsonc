{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glucoscope-usage",
  "main": "src/index.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false,
    "logs": {
      "invocation_logs": false
    }
  },
  "secrets": {
    "required": [
      "TURNSTILE_SECRET_KEY"
    ]
  },
  "d1_databases": [
    {
      "binding": "USAGE_DB",
      "database_name": "glucoscope-usage",
      "database_id": "31db1c25-65a3-44e2-b878-73b18477d4a5",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    {
      "binding": "PLUS_ENTITLEMENT",
      "service": "glucoscope-plus-entitlement",
      "entrypoint": "PlusEntitlementRpc"
    }
  ],
  "triggers": {
    "crons": [
      "17 18 * * *"
    ]
  },
  "vars": {
    "USAGE_COLLECTION_ENABLED": "false",
    "AI_PER_USER_QUOTA_ENABLED": "false",
    "AI_QUOTA_TIMEZONE_OFFSET_HOURS": "9",
    "AI_FREE_DAILY_LIMIT": "1",
    "AI_PLUS_DAILY_LIMIT": "5",
    "AI_QUOTA_RESERVATION_TTL_SECONDS": "600",
    "AI_QUOTA_RETENTION_DAYS": "90",
    "USAGE_NOTICE_VERSION": "2026-08-12-simple-connection-1",
    "USAGE_TIMEZONE_OFFSET_HOURS": "9",
    "CORS_ALLOWED_ORIGIN": "https://glucoscope.app",
    "CORS_ALLOW_REQUESTS_WITHOUT_ORIGIN": "false",
    "MAX_REQUEST_BYTES": "8192",
    "MAX_EVENTS_PER_REQUEST": "20",
    "PROFILE_DAILY_REQUEST_LIMIT": "250",
    "AI_GENERATION_SUCCESS_DAILY_LIMIT": "30",
    "DAILY_USAGE_RETENTION_DAYS": "90",
    "EVENT_RECEIPT_RETENTION_DAYS": "7",
    "INACTIVE_PROFILE_RETENTION_DAYS": "90",
    "TURNSTILE_EXPECTED_HOSTNAME": "glucoscope.app",
    "TURNSTILE_EXPECTED_ACTION": "glucoscope-usage-profile",
    "TURNSTILE_TIMEOUT_MS": "10000"
  }
}
